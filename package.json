{
  "name": "erdwmads-github-io",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "npm run build && npm run export:ppt-data && npm run check:site",
    "check:all": "npm run test:unit && npm run check",
    "check:site": "node scripts/check-site.mjs",
    "images:derive": "node scripts/generate-image-derivatives.mjs",
    "audit:images": "node scripts/audit-images.mjs",
    "audit:css": "node scripts/audit-css.mjs",
    "audit:css:check": "node scripts/audit-css.mjs --check",
    "export:ppt-data": "node scripts/export-ppt-data.mjs",
    "test:mission-publisher": "node --test scripts/publish-protected-mission-log.test.mjs",
    "test:research-lock": "node --test scripts/research-lock.test.mjs scripts/research-passkey.test.mjs",
    "test:mission-index": "node --test scripts/mission-index.test.mjs",
    "test:mission-lightbox": "node --test scripts/mission-lightbox.test.mjs",
    "test:contracts": "node --test scripts/style-contract.test.mjs scripts/audit-css.test.mjs scripts/tokens-contract.test.mjs scripts/plate.test.mjs scripts/js-hooks.test.mjs scripts/theme-preload.test.mjs scripts/soft-nav-scripts.test.mjs",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "publish:mission-log": "node scripts/publish-protected-mission-log.mjs"
  },
  "devDependencies": {
    "astro": "^5.0.0",
    "three-bvh-csg": "^0.0.18"
  },
  "dependencies": {
    "lucide": "^1.41.0",
    "three": "^0.185.1"
  }
}
