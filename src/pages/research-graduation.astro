---
import SiteShell from "../components/SiteShell.astro";
import Masthead from "../components/Masthead.astro";
import Section from "../components/Section.astro";
import MissionLogShell from "../components/MissionLogShell.astro";
import EvidenceAtlasData from "../components/EvidenceAtlasData.astro";
import AnalyticalPathway from "../components/AnalyticalPathway.astro";
import { getPageScripts } from "../data/site";
import { formalTitle, projectContext, laboratories, period } from "../data/project.mjs";

const scriptHtml = getPageScripts("research-graduation");
---

<SiteShell
  title="Graduation Research | I. Mads Lieu"
  description="Password-protected Mission Log for the Orgueil CI1 study of Ca–Mg carbonates reported as dolomite."
  current="research-log"
  pageClass="research-graduation"
  mainClass="main research-graduation-page"
  path="research-graduation.html"
  scriptHtml={scriptHtml}
  noindex
>
  <div class="page">
    <Masthead kicker="Research Log · Protected archive" title="Orgueil CI1 research archive">
      Mission Log of sample preparation, microscopy and microanalysis for the study of Ca–Mg carbonates reported as dolomite in the Orgueil CI1 chondrite.
      <a slot="aside" class="button secondary" href="research-log.html">Research Log overview <span aria-hidden="true">→</span></a>
    </Masthead>
    <EvidenceAtlasData />

    {/* The sealed panel. research-lock.js reveals the passkey block after load and the setup button once the device
        answers; both keep their box from the first paint (data-reserve-space), so revealing them moves nothing below.
        Setup and passkey unlock never show together and share one slot; Forget shows with unlock, beside it. The status
        line holds the height of research-lock.js's longest load-time message, written in data-reserve-text (keep the
        two in step); the stylesheet lays it out invisibly behind the live text. */}
    <section
      id="archive-access"
      class="research-lock-section folio"
      aria-labelledby="archive-access-title"
      data-research-lock-gate
      data-protected-archive-url="assets/data/mission-log.enc.json"
    >
      <div class="research-lock-card">
        <p class="kicker">Access required</p>
        <h2 id="archive-access-title">Graduation Research Log — locked</h2>
        <p>Enter the graduation research password to open the project notes, Mission Log navigator, and image viewer.</p>
        <form class="research-lock-form" data-research-lock-form method="post">
          <label for="research-lock-password">Password</label>
          <div class="research-lock-entry cluster">
            <input
              id="research-lock-password"
              name="password"
              type="password"
              autocomplete="current-password"
              aria-describedby="research-lock-error"
              data-research-lock-input
              required
            >
            <button class="button" type="submit">Unlock with password</button>
          </div>
          <p id="research-lock-error" class="research-lock-error form-error" data-research-lock-error role="alert" hidden>Incorrect password.</p>
        </form>
        <div class="research-passkey-controls" data-passkey-controls data-reserve-space hidden>
          <p class="kicker">Passkey · Windows Hello</p>
          <p
            class="research-passkey-status"
            data-passkey-status
            data-reserve-text="To link this browser, enter your archive password and choose Set up passkey. Complete all device prompts; setup includes an unlock verification."
            role="status"
            aria-live="polite"
          ></p>
          <div class="research-passkey-actions">
            <span class="research-passkey-slot">
              <button class="button secondary" type="button" data-passkey-setup data-reserve-space hidden>Set up passkey</button>
              <button class="button secondary" type="button" data-passkey-unlock data-reserve-space hidden>Unlock with passkey</button>
            </span>
            <button class="research-passkey-forget" type="button" data-passkey-forget hidden>Forget this browser</button>
          </div>
        </div>
        <details class="research-passkey-help">
          <summary>How passkey unlock works</summary>
          <p>Set up verifies your archive password first, then asks your device to create a passkey and prove it can decrypt the shortcut before saving it. Complete all verification prompts. On compatible Windows devices, Windows Hello handles fingerprint, face or PIN verification.</p>
          <p>This browser stores only an encrypted password shortcut. The passkey must support encryption (PRF); otherwise, use your password. Keep your password for recovery: clearing site data, changing browsers or changing the archive password requires a new link.</p>
          <p>Forgetting this browser removes its encrypted shortcut. You can remove the passkey itself in your device’s passkey settings.</p>
        </details>
      </div>
    </section>

    <section class="research-unlocked-session" data-research-lock-session hidden aria-label="Archive access">
      <p data-research-session-notice>Unlocked for this page. Leaving the page locks the archive.</p>
      <button class="button secondary" type="button" data-research-lock-now>Lock log</button>
    </section>

    {/* Unlocked: the bound edition first, then the project context and the pathway as its back matter. */}
    <div class="research-archive-content" data-research-lock-content hidden>
      <MissionLogShell />
      <Section id="graduation-context-title" title="Project context" class="graduation-context">
        <p class="research-formal-title">{formalTitle}</p>
        <dl class="graduation-facts in-notes">
          <div><dt>Period</dt><dd>{period}</dd></div>
          <div>
            <dt>Laboratories</dt>
            <dd>{laboratories.map((lab) => <span class="graduation-facts__lab">{lab.name}, {lab.institution} <small>Adviser: {lab.adviser}</small></span>)}</dd>
          </div>
        </dl>
        {projectContext.map((paragraph) => <p>{paragraph}</p>)}
      </Section>
      <Section id="graduation-pathway-title" kicker="Analytical Pathway" title="From observation to interpretation" class="graduation-pathway">
        <AnalyticalPathway variant="compact" />
        <p class="graduation-note">What each step can answer and cannot establish: <a href="research.html#research-methods-title">the full Analytical Pathway on Research →</a></p>
      </Section>
    </div>
  </div>
</SiteShell>
