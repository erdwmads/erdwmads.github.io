---
import LegacyShell from "../components/LegacyShell.astro";
import MissionLogShell from "../components/MissionLogShell.astro";
import EvidenceAtlasData from "../components/EvidenceAtlasData.astro";
import { getPageScripts } from "../data/site";
import afterLogHtml from "../legacy/research-graduation-after-log.html?raw";
import heroHtml from "../legacy/research-graduation-hero.html?raw";
import projectInfoHtml from "../legacy/research-graduation-project-info.html?raw";

const scriptHtml = getPageScripts("research-graduation");
---

<LegacyShell
  title="Graduation Research | Mads LIU Yong"
  description="Password-protected graduation research Mission Log for the Orgueil CI1 dolomite project."
  current="research-log"
  mainClass="main research-graduation-page"
  path="research-graduation.html"
  scriptHtml={scriptHtml}
>
  <Fragment set:html={heroHtml} />
  <EvidenceAtlasData />

  <section
    id="archive-access"
    class="section research-lock-section"
    data-research-lock-gate
    data-protected-archive-url="assets/data/mission-log.enc.json"
  >
    <div class="research-lock-card">
      <p class="eyebrow">Access Required</p>
      <h2>Graduation Research Log Locked</h2>
      <p>
        Enter the graduation research password to open the project notes, Mission Log navigator,
        and image viewer.
      </p>
      <div class="research-passkey-controls" data-passkey-controls hidden>
        <p class="eyebrow">Passkey · Windows Hello</p>
        <div class="research-passkey-actions">
          <button class="button" type="button" data-passkey-unlock hidden>Unlock with passkey</button>
          <button class="research-passkey-forget" type="button" data-passkey-forget hidden>Forget this browser</button>
        </div>
        <p class="research-passkey-status" data-passkey-status role="status" aria-live="polite"></p>
      </div>
      <form class="research-lock-form" data-research-lock-form method="post">
        <label for="research-lock-password">Password</label>
        <input
          id="research-lock-password"
          name="password"
          type="password"
          autocomplete="current-password"
          aria-describedby="research-lock-error"
          data-research-lock-input
          required
        >
        <div class="research-passkey-actions">
          <button class="button" type="submit">Unlock with password</button>
          <button class="button" type="button" data-passkey-setup hidden>Set up passkey</button>
        </div>
      </form>
      <details class="research-passkey-help">
        <summary>How passkey unlock works</summary>
        <p>Set up verifies your archive password first, then asks your device to create a passkey and prove it can decrypt the shortcut before saving it. Complete all verification prompts. On compatible Windows devices, Windows Hello handles fingerprint, face or PIN verification.</p>
        <p>This browser stores only an encrypted password shortcut. The passkey must support encryption (PRF); otherwise, use your password. Keep your password for recovery: clearing site data, changing browsers or changing the archive password requires a new link.</p>
        <p>Forgetting this browser removes its encrypted shortcut. You can remove the passkey itself in your device’s passkey settings.</p>
      </details>
      <p id="research-lock-error" class="research-lock-error" data-research-lock-error role="alert" hidden>Incorrect password.</p>
    </div>
  </section>

  <section class="research-unlocked-session" data-research-lock-session hidden aria-label="Archive access">
    <p data-research-session-notice>Unlocked for this page. Leaving the page locks the archive.</p>
    <button class="button" type="button" data-research-lock-now>Lock log</button>
  </section>

  <div data-research-lock-content hidden>
    <Fragment set:html={projectInfoHtml} />
    <MissionLogShell />
    <Fragment set:html={afterLogHtml} />
  </div>
</LegacyShell>
