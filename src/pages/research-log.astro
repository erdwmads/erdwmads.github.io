---
import SiteShell from "../components/SiteShell.astro";
import Masthead from "../components/Masthead.astro";
import Section from "../components/Section.astro";
import AnalyticalPathway from "../components/AnalyticalPathway.astro";
import { getPageScripts } from "../data/site";
import { displayTitle, formalTitle, question, targetMaterial, targetPhase, methodsSummary, laboratories, period, projectStatus } from "../data/project.mjs";

const scriptHtml = getPageScripts("research-log");
// What the protected archive holds, described in general terms only. Nothing here may come from
// the archive itself: no entry counts, dates, SOL numbers, stages or titles.
const archiveParts: [string, string][] = [
  ["Mission Log", "Dated entries, each with a SOL number: what was done, what was observed or limited, and what happens next, closed by a short Recorded / Still open / Next step summary."],
  ["Mission Index", "A navigator across the entries, for jumping to a record by its number and date."],
  ["Figures", "Images from sample preparation and microscopy, with numbered captions."],
  ["Evidence atlas", "For each entry, its figures, tables, current stage and next step, beside the public background reading."]
];
---

<SiteShell title='Research Log | I. Mads Lieu' description='Research Log for Dolomite in Orgueil CI1: the question, the Analytical Pathway and what the protected Mission Log archive holds.' current='research-log' mainClass='main research-log-main' path="research-log.html" scriptHtml={scriptHtml}>
  <div class="page">
    {/* The accession record in version 1's dashboard (owner, 2026-11-25): the project status as a badge with its
        period above the title, the formal title and the summary; the public facts beside them from 761 px; the ways
        on (the protected archive and the Research overview, as version 1's two buttons) across both columns under a
        line. The status line is the project's, not a pathway status, so it has no marker; the " · " between status
        and period is kept for screen readers and copied text. The methods are set one status per line, in the words
        of methodsSummary, with the " · " kept the same way. */}
    <div class="log-record folio">
      <Masthead kicker="Research Log · Graduation research" title={displayTitle} id="current-project-title">
        {formalTitle}
        <Fragment slot="meta"><span class="log-status">{projectStatus}</span><span class="visually-hidden"> · </span>{period}</Fragment>
      </Masthead>
      <p class="log-summary">Public overview of my undergraduate graduation research. The question and the Analytical Pathway are on this page; the dated laboratory records are in the protected Mission Log archive.</p>
      <dl class="log-facts in-notes">
        <div><dt class="kicker">Research question</dt><dd>{question}</dd></div>
        <div><dt class="kicker">Material</dt><dd>{targetMaterial} · {targetPhase}</dd></div>
        <div><dt class="kicker">Methods</dt><dd>{methodsSummary.split(" · ").map((part, index) => <Fragment>{index > 0 && <span class="visually-hidden"> · </span>}<span class="log-facts__line">{part}</span></Fragment>)}</dd></div>
        <div>
          <dt class="kicker">Laboratories</dt>
          <dd>{laboratories.map((lab) => <Fragment><span class="log-facts__line">{lab.name}, {lab.institution} <small>Adviser: {lab.adviser}</small></span>{" "}</Fragment>)}</dd>
        </div>
      </dl>
      <div class="log-actions cluster">
        <a class="button" href="research-graduation.html">Open protected archive</a>
        <a class="button secondary" href="research.html">Research overview <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <Section id="research-log-pathway-title" kicker="Analytical Pathway" title="From observation to interpretation" class="log-pathway">
      <AnalyticalPathway variant="compact" />
      <p class="log-note">What each step can answer and cannot establish: <a href="research.html#research-methods-title">the full Analytical Pathway on Research →</a></p>
    </Section>

    <Section id="research-log-archive-title" kicker="Protected archive" title={"What the Mission\u00a0Log archive holds"} class="research-log-archive">
      <p>The laboratory record of this project is kept as an encrypted archive. It opens in the browser with the archive password or a linked passkey, and locks again when you leave the page.</p>
      <dl class="log-parts">
        {archiveParts.map(([term, text]) => (
          <div><dt>{term}</dt><dd>{text}</dd></div>
        ))}
      </dl>
      {/* Version 1's callout: the caveat and the way in, side by side in one framed box. */}
      <div class="log-callout framed">
        <p class="log-note">Entries are working records of unpublished research; their observations and interpretations are provisional.</p>
        <p class="log-access"><a class="button" href="research-graduation.html">Open protected archive</a></p>
      </div>
    </Section>
  </div>
</SiteShell>
