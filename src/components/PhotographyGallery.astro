---
import { photographs } from "../data/photography";

// Rendered slot widths (observatory-experience.css): two columns with a 10px gap inside 20px gutters
// up to 760px, then three columns with 16px gaps inside 40px gutters in a 1280px main. Panoramas span the wall.
const sizes = {
  tile: "(max-width: 760px) calc((100vw - 50px) / 2), (max-width: 1280px) calc((100vw - 112px) / 3), 390px",
  wide: "(max-width: 760px) calc(100vw - 40px), (max-width: 1280px) calc(100vw - 80px), 1200px"
};
---

<section>
  <p class="eyebrow">Photography</p>
  <h1>Photography</h1>
  <p class="lead">
    I use <s class="del">Hasselblad X2D</s><span class="visually-hidden"> (crossed out)</span> Pentax 6x7 for film-inspired
    photographs, environmental portraits, and visual notes.
  </p>
</section>

<section class="section photo-experience" data-photo-experience aria-label="Photographs">
  <div class="obs-photo-tools"><div class="photo-layout-switch" data-photo-layout-controls role="group" aria-label="Photograph layout" hidden><button type="button" data-photo-layout="gallery" aria-pressed="true">Gallery</button><button type="button" data-photo-layout="contact" aria-pressed="false">Contact sheet</button></div><button class="button secondary obs-present-launch" type="button" data-present-photos hidden>Present photographs</button></div>
  <div class="photo-wall">
    {photographs.map((photo, index) => (
      <a
        class:list={["photo-tile", { "photo-tile--wide": photo.wide }]}
        href={photo.full}
        data-photo-index={index}
        aria-label={`Open photograph ${photo.number}: ${photo.alt}`}
      >
        <img
          src={photo.thumb}
          srcset={photo.srcset}
          sizes={photo.wide ? sizes.wide : sizes.tile}
          data-full-src={photo.full}
          width={photo.width}
          height={photo.height}
          alt={photo.alt}
          loading={index < 3 ? "eager" : "lazy"}
          decoding="async"
          fetchpriority={index === 0 ? "high" : "auto"}
        />
        <span class="photo-index-label" aria-hidden="true"><b>{photo.number}</b><span>{photo.alt}</span></span>
      </a>
    ))}
  </div>
</section>

<section class="section two-col">
  <h2 class="section-label">Camera</h2>
  <div class="card">
    <h3>Current setup</h3>
    <p>
      <s class="del">Hasselblad X2D</s><span class="visually-hidden"> (crossed out)</span> Pentax 6x7, SMC Pentax 67 90mm F2.8 Lens,
      and Samsung Galaxy series smartphones.
    </p>
  </div>
</section>
