---
import { photographs } from "../data/photography";

---

<section>
  <p class="eyebrow">Photography</p>
  <h1>Photography</h1>
  <p class="lead">
    I use <span class="del">Hasselblad X2D</span> Pentax 6x7 for film-inspired
    photographs, environmental portraits, and visual notes.
  </p>
</section>

<section class="section photo-experience" aria-label="Photographs">
  <div class="obs-photo-tools"><button class="button secondary obs-present-launch" type="button" data-present-photos>Present photographs</button></div>
  <div class="photo-wall">
    {photographs.map((photo, index) => (
      <a
        class:list={["photo-tile", { "photo-tile--wide": photo.width / photo.height > 2.3 }]}
        href={photo.full}
        data-photo-index={index}
        aria-label={`Open photograph ${photo.number}: ${photo.alt}`}
      >
        <img
          src={photo.thumb}
          srcset={`${photo.thumb} 480w, ${photo.full} ${photo.width}w`}
          sizes={photo.width / photo.height > 2.3
            ? '(max-width: 760px) calc(100vw - 40px), (max-width: 1280px) calc(100vw - 80px), 1200px'
            : '(max-width: 760px) calc((100vw - 50px) / 2), (max-width: 1280px) calc((100vw - 112px) / 3), 390px'}
          data-full-src={photo.full}
          width={photo.width}
          height={photo.height}
          alt={photo.alt}
          loading={index < 3 ? "eager" : "lazy"}
          decoding="async"
          fetchpriority={index === 0 ? "high" : "auto"}
        />
      </a>
    ))}
  </div>
</section>

<section class="section two-col">
  <div class="section-label">Camera</div>
  <div class="card">
    <h3>Current setup</h3>
    <p>
      <span class="del">Hasselblad X2D</span> Pentax 6x7, SMC Pentax 67 90mm F2.8 Lens,
      and Samsung Galaxy series smartphones.
    </p>
  </div>
</section>
