---
import { papers } from "../data/papers";

const filters = [
  { label: "All", id: "" },
  { label: "Dolomite", id: "dolomite" },
  { label: "CI / Orgueil", id: "ci-orgueil" },
  { label: "Ryugu / Bennu", id: "ryugu-bennu" },
  { label: "Methods", id: "methods" },
  { label: "Chronology", id: "chronology" }
];
---

<section>
  <p class="eyebrow">Paper Shelf</p>
  <h1>Paper Shelf</h1>
  <p class="lead">
    A curated reading shelf for papers related to my graduation research: dolomite, carbonates,
    CI chondrites, Orgueil, Ryugu, Bennu, aqueous alteration, and analytical mineralogy.
  </p>
</section>

<section class="section paper-shelf-tools" aria-label="Paper Shelf filters">
  <div class="paper-shelf-search">
    <label for="paper-search">Search</label>
    <input id="paper-search" type="search" placeholder="Search title, author, tag..." data-paper-search>
  </div>
  <div class="paper-filter-row" data-paper-filters>
    {filters.map((filter, index) => (
      <button
        class="paper-filter"
        type="button"
        data-paper-filter={filter.id}
        aria-pressed={index === 0 ? "true" : "false"}
      >
        {filter.label}
      </button>
    ))}
  </div>
</section>

<div class="paper-results"><p data-paper-count role="status" aria-live="polite">{papers.length} papers</p><button class="button secondary" type="button" data-paper-reset hidden>Clear filters</button></div>
<p data-paper-empty hidden>No papers match this search. Try a broader term or clear the filters.</p>
<section class="section paper-shelf" aria-label="Reading list">
  {papers.map((paper, index) => (
    <article
      id={`paper-${index + 1}`}
      class="paper-card"
      data-paper-card
      data-paper-text={`${paper.status} ${paper.title} ${paper.authors} ${paper.summary} ${paper.tags.join(" ")}`.toLowerCase()}
      data-paper-filters={paper.filters.join(" ")}
    >
      <div class="paper-status">{paper.status}</div>
      <div class="paper-card-body">
        <h2><a href={paper.url} target="_blank" rel="noopener">{paper.title}</a></h2>
        <p class="muted">{paper.authors}</p>
        <p>{paper.summary}</p>
        <div class="paper-reference-actions">
          <a class="paper-source" href={paper.url} target="_blank" rel="noopener" aria-label={`Read paper: ${paper.title} (opens in a new tab)`}>Read paper <span aria-hidden="true">↗</span></a>
          <button
            class="button secondary"
            type="button"
            data-paper-copy
            data-paper-reference={`${paper.authors}. ${paper.title}. ${paper.url}`}
            aria-label={`Copy reference: ${paper.title}`}
          >Copy reference</button>
        </div>
        <p class="muted paper-reference-status" data-paper-copy-status role="status" aria-live="polite" aria-atomic="true"></p>
        <div class="paper-reference-fallback" data-paper-copy-fallback hidden>
          <label for={`paper-reference-${index + 1}`}>Reference — author, title, and DOI link</label>
          <textarea id={`paper-reference-${index + 1}`} data-paper-reference-text readonly rows="4"></textarea>
        </div>
        <div class="project-tags">
          {paper.tags.map((tag) => <span>{tag}</span>)}
        </div>
      </div>
    </article>
  ))}
</section>

<section class="section research-reading-context" aria-labelledby="reading-context-title">
  <p class="eyebrow">Reading in context</p>
  <h2 id="reading-context-title">How the references connect</h2>
  <p>Dolomite-growth studies frame the formation question; CI and Orgueil mineralogy provides the material context. Ryugu and Bennu offer returned-sample comparisons for aqueous alteration.</p>
  <p>Nakamura et al.’s proposed Ryugu history is illustrated in <a href="origins-study.html">Origins</a>. Together, these references inform the <a href="research.html#research-methods-title">analytical pathway of my Orgueil research</a>.</p>
</section>
