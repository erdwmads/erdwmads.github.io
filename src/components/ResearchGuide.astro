---
interface Props {
  label?: string;
  ariaLabel?: string;
  sections?: [string, string][];
}

const {
  label = 'In Research',
  ariaLabel = 'Research sections',
  sections = [
    ['research-focus-title', 'Research question'],
    ['research-methods-title', 'Analytical methods'],
    ['comparison-title', 'Comparison materials']
  ]
} = Astro.props;
---
<nav class="research-guide" data-research-guide aria-label={ariaLabel}>
  <span class="research-guide-label">{label}</span>
  <button type="button" data-research-guide-toggle aria-expanded="false" aria-controls="research-guide-links" hidden>
    <span><small>{label}</small><strong data-research-guide-current>{sections[0][1]}</strong></span>
    <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="m5 8 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
  </button>
  <ol id="research-guide-links">
    {sections.map(([id, title], index) => <li><a href={'#' + id} data-section-label={title}><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>{title}</a></li>)}
  </ol>
</nav>
