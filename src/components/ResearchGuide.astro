---
const sections = [
  ['research-focus-title', 'Research question'],
  ['research-methods-title', 'Analytical methods'],
  ['missions-title', 'Sample-return missions'],
  ['planetary-title', 'Materials & orbits'],
  ['research-scale-title', 'Published microscopy']
];
---
<nav class="research-guide" data-research-guide aria-label="Research sections">
  <span class="research-guide-label">In Research</span>
  <button type="button" data-research-guide-toggle aria-expanded="false" aria-controls="research-guide-links" hidden>
    <span><small>In Research</small><strong data-research-guide-current>Research question</strong></span>
    <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="m5 8 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
  </button>
  <ol id="research-guide-links">
    {sections.map(([id, label], index) => <li><a href={'#' + id} data-section-label={label}><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>{label}</a></li>)}
  </ol>
</nav>
