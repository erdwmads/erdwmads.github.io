---
import '../styles/arrival.css';
interface Props { home: boolean; }
const {home}=Astro.props;
---
<dialog id="cosmic-arrival" data-home={String(home)} aria-label="Astromineralogy" aria-describedby="arrival-question">
  <div id="arrival-universe" aria-hidden="true"></div>
  <div class="arrival-signature">
    <span>ASTROMINERALOGY</span>
    <p id="arrival-question">What was responsible for making diverse planets in the Solar System?</p>
    <p class="arrival-name">I. Mads Lieu</p>
  </div>
  <div class="arrival-bottom">
    <span class="arrival-sequence" aria-hidden="true"><span class="arrival-number">01</span><span class="arrival-label">GALACTIC DUST</span><span class="arrival-track"><span></span></span></span>
    <button id="arrival-skip" type="button" autofocus aria-keyshortcuts="Escape">Skip intro <span class="arrival-skip-key" aria-hidden="true">Esc</span><span data-arrival-icon="next"></span></button>
  </div>
</dialog>
{/* The skip link (slot) follows the dialog, so the first Tab after the entrance closes reaches it without moving focus by script. */}
<slot />
<button id="arrival-replay" type="button" title="Replay entrance animation" aria-label="Replay entrance animation" hidden><span data-arrival-icon="replay"></span></button>
<script is:inline data-arrival-gate>
  (()=>{
    const gate=document.querySelector('#cosmic-arrival');
    let played=false,disabled=false;
    try{played=sessionStorage.getItem('mads-cosmic-arrival-v1')==='done';disabled=localStorage.getItem('madsAmbientFxEnabled')==='0';}catch{}
    if(gate.dataset.home!=='true'||location.hash||played||disabled||navigator.connection?.saveData||matchMedia('(prefers-reduced-motion: reduce)').matches)return;
    gate.showModal();gate.dataset.state='preparing';document.documentElement.classList.add('cosmic-arrival-active');window.cosmicArrivalOpened=performance.now();
    // A failed or slow module must never leave the page behind a modal or a scroll lock; entry.js uses the same 3 s cap.
    window.cosmicArrivalFallback=setTimeout(()=>{gate.close();gate.dataset.state='complete';document.documentElement.classList.remove('cosmic-arrival-active');},3000);
    // However the dialog closes (Skip or Back before the module has loaded), release the scroll lock at once.
    gate.addEventListener('close',()=>{if(gate.open)return;clearTimeout(window.cosmicArrivalFallback);document.documentElement.classList.remove('cosmic-arrival-active');});
    document.querySelector('#arrival-skip')?.addEventListener('click',()=>gate.close());
  })();
</script>
<script>
  import '../scripts/arrival/entry.js';
</script>
