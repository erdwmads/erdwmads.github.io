---
// The home entrance, a title page over the scene: the name, a rule, the imprint line, then the question. CSS orders
// them; the DOM keeps the question first, so aria-describedby reads it. Elements that the scripts find by id also
// carry a class, the only style hook (spec §2.3). Styles: src/styles/folio/components/arrival.css, part of the one
// stylesheet bundle (stylesheets in src/data/site.ts).
import { inlineScripts } from '../lib/inline-scripts';
interface Props { home: boolean; }
const {home}=Astro.props;
---
<dialog id="cosmic-arrival" class="arrival on-night" data-home={String(home)} aria-label="Astromineralogy" aria-describedby="arrival-question">
  <div id="arrival-universe" class="arrival-universe" aria-hidden="true"></div>
  <div class="arrival-signature">
    <span class="arrival-imprint">Astromineralogy research archive&nbsp;· Interface&nbsp;2046</span>
    <p id="arrival-question" class="arrival-question">What was responsible for making diverse planets in the Solar System?</p>
    <p class="arrival-name">I. Mads Lieu</p>
  </div>
  <div class="arrival-bottom">
    <span class="arrival-sequence" aria-hidden="true"><span class="arrival-number tabular">01</span><span class="arrival-label">GALACTIC DUST</span><span class="arrival-track"><span></span></span></span>
    <button id="arrival-skip" class="arrival-skip" type="button" autofocus aria-keyshortcuts="Escape">Skip intro <span class="arrival-skip-key" aria-hidden="true">Esc</span><span data-arrival-icon="next"></span></button>
  </div>
</dialog>
{/* The skip link (slot) follows the dialog, so the first Tab after the entrance closes reaches it without moving focus by script. */}
<slot />
<button id="arrival-replay" class="arrival-replay" type="button" title="Replay entrance animation" aria-label="Replay entrance animation" hidden><span data-arrival-icon="replay"></span></button>
<script is:inline data-arrival-gate set:html={inlineScripts.arrivalGate}></script>
<script>
  import '../scripts/arrival/entry.js';
</script>
