---
import { brand, footerItems, navItems, researchLogGate, siteMetadata } from "../data/site";
import CosmicArrival from './CosmicArrival.astro';

interface Props {
  title: string;
  description: string;
  current: string;
  mainClass?: string;
  path?: string;
  scriptHtml: string;
}

const { title, description, current, mainClass = "main", path, scriptHtml } = Astro.props;
const canonicalPath = path || "index.html";
const canonicalUrl = new URL(canonicalPath, `${siteMetadata.url}/`).toString();
const imageUrl = new URL(siteMetadata.image, `${siteMetadata.url}/`).toString();
const bodyClass = `site-refined ui-page-${current}`;
---

<!doctype html>
<html lang="en" data-theme="space" data-theme-space>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalUrl}>
  <meta name="theme-color" content="#040910" media="(prefers-color-scheme: dark)">
  <meta name="theme-color" content="#edf3f7" media="(prefers-color-scheme: light)">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content={siteMetadata.title}>
  <meta property="og:locale" content={siteMetadata.locale}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:image" content={imageUrl}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={imageUrl}>
  <script is:inline>
    (function () {
      try {
        var savedTheme = localStorage.getItem("mads-theme");
        if (savedTheme === "light") {
          document.documentElement.setAttribute("data-theme", "light");
          document.documentElement.removeAttribute("data-theme-space");
          document.documentElement.classList.remove("theme-preloaded-space");
          document.documentElement.style.backgroundColor = "#edf3f7";
        } else {
          document.documentElement.setAttribute("data-theme", "space");
          document.documentElement.setAttribute("data-theme-space", "");
          document.documentElement.classList.add("theme-preloaded-space");
          document.documentElement.style.backgroundColor = "#040910";
        }
      } catch (error) {
        document.documentElement.setAttribute("data-theme", "space");
        document.documentElement.setAttribute("data-theme-space", "");
        document.documentElement.classList.add("theme-preloaded-space");
        document.documentElement.style.backgroundColor = "#040910";
      }
    })();
  </script>
  <style is:inline>
    html { background: #040910; color-scheme: dark; }
    html[data-theme="light"]:not([data-theme-space]) {
      background: #edf3f7 !important;
      color-scheme: light;
    }
    html[data-theme="space"],
    html[data-theme-space] {
      background: #040910 !important;
      color-scheme: dark;
    }
    html[data-theme="space"] body,
    html[data-theme-space] body {
      background-color: #040910 !important;
      color: #edf7ff;
    }
  </style>
  <link rel="preload" href="assets/fonts/montserrat-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="assets/css/style.css?v=20260908-stable-controls">
  <link rel="stylesheet" href="assets/css/tokens.css">
  <link rel="stylesheet" href="assets/css/shell-evolution.css?v=20260831-stability">
  <link rel="stylesheet" href="assets/css/research-log-evolution.css?v=20260909-progress">
    <link rel="stylesheet" href="assets/css/observatory.css?v=20260907-reading">
  <link rel="stylesheet" href="assets/css/observatory-experience.css?v=20260909-hierarchy">
    <link rel="stylesheet" href="assets/css/mineral-interactions.css?v=20260907-workflow">
    <link rel="stylesheet" href="assets/css/research-scale.css?v=20260907-reading">
    <link rel="stylesheet" href="assets/css/planetary-explorer.css?v=20260908-stable-controls">
    <link rel="stylesheet" href="assets/css/typography.css?v=20260908-original-montserrat">
    <script>
      import '../scripts/planetary-explorer.js';
    </script>
  <link rel="icon" href="favicon.ico" sizes="any">
  <link rel="icon" type="image/png" href="assets/img/favicon.png">
  <link rel="apple-touch-icon" href="assets/img/apple-touch-icon.png">
</head>
<body id="academic-site" class={bodyClass}>
<CosmicArrival home={current === 'home'} />
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={brand.homeHref}>
      <strong>{brand.name}</strong>
      <span set:html={brand.tagline} />
    </a>
    <button
      class="nav-toggle"
      type="button"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="mobile-navigation"
      data-nav-toggle
    >
      <span aria-hidden="true"></span>
    </button>
    <div class="header-actions" id="mobile-navigation" data-mobile-nav>
      <nav class="nav" aria-label="Main navigation">
        <div class="nav__links">
          {navItems.map((item) => <a href={item.href} aria-current={current === item.key ? "page" : undefined}>{item.label}</a>)}
        </div>
      </nav>
      <a class="nav-log-gate" href={researchLogGate.href} aria-current={current === researchLogGate.key ? "page" : undefined}>
        <span class="nav-log-gate__signal" aria-hidden="true"></span>
        <span class="nav-log-gate__copy">
          <strong>{researchLogGate.label}</strong>
          <small>{researchLogGate.status}</small>
        </span>
      </a>
      <button class="theme-toggle" type="button" aria-label="Toggle light and space mode" aria-pressed="true">Light Mode</button>
    </div>
  </div>
</header>
<main class={mainClass}>
  <slot />
</main>
<footer class="site-footer">
  <div class="footer-inner">
    {footerItems.map((item) => <span>{item}</span>)}
  </div>
</footer>
<Fragment set:html={scriptHtml} />
</body>
</html>

