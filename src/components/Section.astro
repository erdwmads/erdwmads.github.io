---
// A section on the .folio grid, labelled by its heading: an optional number in the hanging margin, the kicker, the
// heading, a lead (slot "lead"), the body (default slot, each child a grid item in the text column), margin items
// (slot "margin") and notes (slot "notes", placed after the body). A note that belongs beside one paragraph goes
// straight after it in the default slot, as an element with class in-notes. Styles: src/styles/folio/04-layout.css.
import Kicker from "./Kicker.astro";
import { sectionProps } from "./section.js";

interface Props {
  id: string;
  number?: string;
  kicker?: string;
  title: string;
  level?: 2 | 3;
  class?: string;
  labelledby?: string;
}

const { id, number, kicker, title, level, labelledby } = sectionProps(Astro.props);
const { class: className } = Astro.props;
const Heading = `h${level}`;
---
<section class:list={["folio-section", "folio", className]} aria-labelledby={labelledby}>
  {number && <span class="folio-section__number in-margin">{number}</span>}
  {kicker && <Kicker>{kicker}</Kicker>}
  <Heading id={id}>{title}</Heading>
  {Astro.slots.has("lead") && <div class="folio-section__lead"><slot name="lead" /></div>}
  {Astro.slots.has("margin") && <div class="in-margin"><slot name="margin" /></div>}
  <slot />
  {Astro.slots.has("notes") && <aside class="in-notes"><slot name="notes" /></aside>}
</section>
