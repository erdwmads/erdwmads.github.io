---
import { papers } from '../data/papers';
const data = {
  question: 'What conditions controlled dolomite formation in the Orgueil CI1 chondrite?',
  literature: papers.map((paper, index) => ({ ...paper, href: `paper-shelf.html#paper-${index + 1}` }))
    .filter(paper => paper.filters.includes('dolomite') || paper.filters.includes('ci-orgueil')),
  methods: [
    { title: 'Texture', text: 'SEM–EDS / BSE observation: morphology, elemental screening and spatial relationships to clay-rich areas.' },
    { title: 'Chemistry', text: 'EPMA mapping and microanalysis: elemental distribution and carbonate chemistry.' },
    { title: 'Preparation', text: 'Planned EBSD-guided FIB preparation: regions selected and oriented for TEM sections and a single grain for XRD.' },
    { title: 'Structure', text: 'Planned single-grain XRD and TEM on FIB-prepared material: ordering, interfaces and nanoscale structure.' }
  ]
};
---
<template data-public-atlas-data>{JSON.stringify(data)}</template>
