---
// Public research atlas data (read by public/assets/js/mineral-interactions.js).
// Project facts come from src/data/project.mjs; the reading list from the Paper Shelf.
import { papers, paperAuthorYear } from '../data/papers';
import { atlasProjectData } from '../data/project.mjs';

const data = {
  ...atlasProjectData(),
  literature: papers.map(paper => ({ ...paper, authors: paperAuthorYear(paper), href: `paper-shelf.html#${paper.legacyAnchor ?? paper.id}` }))
    .filter(paper => paper.filters.includes('dolomite') || paper.filters.includes('ci-orgueil'))
};
---
<template data-public-atlas-data>{JSON.stringify(data)}</template>
